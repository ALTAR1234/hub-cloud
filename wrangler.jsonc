{
  // Hub: phone app for Jarvis, Streamer, Weber, Listener and Gamer, on Cloudflare's free plan.
  "name": "hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "HUB", "id": "bb96ac9e529e4670bf7a7cbdbd56e501" }],
  "vars": { "GEMINI_MODEL": "gemini-3.8-flash", "GEMINI_FALLBACKS": "gemini-3.8-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite", "WEATHER_CITY": "Austin", "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts", "JARVIS_VOICE": "Charon" }
  // secrets (set with `wrangler secret put`, never stored here): GEMINI_API_KEY, SETUP_CODE
}
